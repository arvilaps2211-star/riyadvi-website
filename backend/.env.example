# Copy this file to .env and fill in real local values.
# Never commit the real .env file.

# Port the Express API listens on.
PORT=5000

# PostgreSQL connection string. Example local format:
#   postgresql://<user>:<password>@localhost:5432/riyadvi_dev
DATABASE_URL=

# development | production
NODE_ENV=development

# Origin allowed by CORS — the frontend's URL. Update this to the deployed
# Vercel URL in production.
FRONTEND_URL=http://localhost:3000

# --- Admin Dashboard (Phase 9) -----------------------------------------
# Secret used to sign the admin session JWT. Generate a long random value,
# e.g.: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
# Never reuse this value across environments, and never commit a real one.
ADMIN_JWT_SECRET=

# How long an admin session stays valid, e.g. 8h, 1d, 7d.
ADMIN_SESSION_EXPIRES_IN=8h

# true in production (HTTPS deployments) so the admin cookie is sent with
# Secure + SameSite=None, which is required for a cross-site cookie
# (Vercel frontend + Render/Railway backend) to work at all. Keep false for
# local HTTP development, where SameSite=Lax already works because
# localhost:3000 and localhost:5000 are same-site.
COOKIE_SECURE=false
