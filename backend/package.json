{
  "name": "backend",
  "version": "1.0.0",
  "description": "Riyadvi Software Technologies — Express + PostgreSQL API for lead-generation forms (Stage 8).",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "echo \"No automated tests yet\" && exit 0",
    "create-admin": "ts-node-dev --transpile-only --respawn=false scripts/createAdminUser.ts",
    "migrate": "node -e \"console.log('Run: psql \\\"$DATABASE_URL\\\" -f database/schema.sql && psql \\\"$DATABASE_URL\\\" -f database/migrations/001_phase9_admin_dashboard.sql')\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}
